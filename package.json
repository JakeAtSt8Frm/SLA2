{
  "name": "sla2",
  "version": "2.0.0",
  "private": true,
  "description": "League intelligence for Sleeper fantasy football leagues with custom scoring, IDP and superflex.",
  "type": "module",
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "build:static": "VITE_STATIC=1 vite build && node scripts/build-static.ts && cp dist/index.html dist/404.html && touch dist/.nojekyll",
    "preview:static": "vite preview --port 5181 --strictPort",
    "start": "NODE_ENV=production node server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "research:fetch": "node research/fetch-history.ts",
    "research:dataset": "node research/build-dataset.ts",
    "research:train": "research/.venv/bin/python research/train.py",
    "research:backtest": "node research/backtest.ts",
    "research:review": "research/.venv/bin/python research/review.py",
    "research": "npm run research:fetch && npm run research:dataset && npm run research:train && npm run research:backtest && npm run research:review",
    "research:espn": "for id in espn-390483100 espn-1159035309; do node research/build-dataset.ts $id && research/.venv/bin/python research/train.py $id && node research/backtest.ts $id || exit 1; done",
    "smoke": "node scripts/smoke.ts",
    "espn:claim": "node scripts/espn-claim.ts",
    "bench": "node scripts/bench.ts",
    "verify:scoring": "node research/verify-scoring.ts",
    "verify:espn": "node research/verify-espn.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@tanstack/react-query": "^5.103.2",
    "hono": "^4.13.9",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
