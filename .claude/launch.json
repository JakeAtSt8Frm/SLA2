{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sla-web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js"
      ],
      "port": 5180
    },
    {
      "name": "sla-api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--watch-path=server",
        "--watch-path=engine",
        "--watch-path=model",
        "server/index.ts"
      ],
      "port": 8787
    },
    {
      "name": "sla-static",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "preview",
        "--port",
        "5181",
        "--strictPort",
        "--base",
        "/SLA2/"
      ],
      "port": 5181
    },
    {
      "name": "sla-api-dry-run",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SLA_CLAIMS_DRY_RUN=1",
        "SLA_CLAIMS_FILE=data/claims-dry-run.json",
        "node",
        "--watch-path=server",
        "--watch-path=engine",
        "--watch-path=model",
        "server/index.ts"
      ],
      "port": 8787
    }
  ]
}
